# Create React App env file
#
# Notes:
# - `PUBLIC_URL=.` keeps built assets working behind a proxy.
# - `REACT_APP_API_URL` is OPTIONAL. When unset, the frontend calls `/api/status` on the same origin.
#   If you need to force calls through a Code Studio proxy path, set it to something like:
#   REACT_APP_API_URL=/code-studios/<PROJECT_KEY>/<STUDIO_ID>/8080/proxy/8995

DANGEROUSLY_DISABLE_HOST_CHECK=true
WDS_SOCKET_PORT=0
PUBLIC_URL=.

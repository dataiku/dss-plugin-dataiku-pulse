META = {
    "id": "scenarios.by_trigger_type_top_10",
    "version": 1,
    "label": "Scenarios by Trigger Type (Top 10)",
    "description": "Top 10 scenario trigger types across instances",
    "type": "graph",
    "tab": "summary",
    "graph": {
        "kind": "bar",
        "x": "trigger_type",
        "y": "scenario_count",
        "color": "instance_name",
        "barmode": "group",
        "x_title": "Trigger Type",
        "y_title": "Number of Scenarios",
        "legend_title": "Instance",
        "labels": {
            "trigger_type": "Trigger Type",
            "scenario_count": "Scenarios",
            "instance_name": "Instance"
        }
    }
}

def query():
    return """
        WITH base AS (
            SELECT
                instance_name,
                scenario_triggerType AS trigger_type
            FROM scenarios_metadata_base
            WHERE scenario_triggerType IS NOT NULL
        ),
        top_triggers AS (
            SELECT
                trigger_type
            FROM base
            GROUP BY trigger_type
            ORDER BY COUNT(*) DESC
            LIMIT 10
        )
        SELECT
            b.instance_name,
            b.trigger_type,
            COUNT(*) AS scenario_count
        FROM base b
        JOIN top_triggers t
            ON b.trigger_type = t.trigger_type
        GROUP BY
            b.instance_name,
            b.trigger_type
        ORDER BY
            scenario_count DESC,
            b.instance_name
    ;
    """

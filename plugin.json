{
    "id": "dataiku-pulse",
    "version": "2.0.0",
    "meta": {
        "label": "Dataiku PULSE",
        "description": "This plugin contains the framework for the Dataiku PULSE Dashbaord.",
        "author": "Stephen Mazzei",
        "icon": "fas fa-puzzle-piece",
        "tags": ["Administration", "PULSE", "Data Gather", "Insights", "Usages"],
        "url": "https://github.com/dataiku/dss-plugin-sage-insights",
        "licenseInfo": "Apache Software License"
    },
    "params": [
        {
            "name": "pulse_repo_url",
            "label": "Sage Github Repo",
            "type": "STRING",
            "description": "",
            "mandatory": true
        },
        {
            "name": "pulse_repo_branch",
            "label": "Sage Github Branch",
            "type": "STRING",
            "description": "",
            "mandatory": true
        },
        {
            "name": "sep_pulse_dashboard",
            "description": "<hr color='#000000' size='3' noshade><h3>Sage Dashboard Information</h3>",
            "type": "SEPARATOR"
        },
        {
            "name": "pulse_project_key",
            "label": "Sage Dashboard Project Key",
            "type": "STRING",
            "description": "",
            "mandatory": true
        },
        {
            "name": "pulse_project_url",
            "label": "Sage Dashboard Main Host URL",
            "type": "STRING",
            "description": "",
            "mandatory": true
        },
        {
            "name": "pulse_project_api",
            "label": "Sage Dashboard Main Host API",
            "type": "PASSWORD",
            "description": "API Key running as an ADMIN level user",
            "mandatory": true
        },
        {
            "name": "pulse_worker_key",
            "label": "Sage Worker Project Key",
            "type": "STRING",
            "description": "",
            "mandatory": true
        },
        {
            "name": "pulse_dataiku_user",
            "label": "Sage Worker Dataiku User",
            "type": "STRING",
            "description": "",
            "mandatory": true
        },
        {
            "type": "BOOLEAN",
            "name": "ignore_certs",
            "label": "Ignore Certificates and force trust TLS",
            "defaultValue": false
        },
        {
            "name": "pulse_folder_connection",
            "label": "Sage Folder Connection",
            "type": "STRING",
            "description": "",
            "mandatory": true
        },
        {
            "name": "sep_pulse_workers",
            "description": "<hr color='#000000' size='3' noshade><h3>Sage Worker Information</h3>",
            "type": "SEPARATOR"
        },
        {
            "name": "api_configs",
            "label": "Sage Worker Host URLs and API Keys",
            "type": "OBJECT_LIST",
            "subParams": [
                {
                    "name": "worker_url",
                    "label": "Worker Host URL",
                    "type": "STRING",
                    "description": "",
                    "mandatory": true
                },
                {
                    "name": "worker_api",
                    "label": "Worker Host API",
                    "type": "PASSWORD",
                    "description": "API Key running as an ADMIN level user",
                    "mandatory": true
                }
            ]
        }
    ]
}

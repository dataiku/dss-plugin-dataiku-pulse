# .bandit - Bandit Security Linter Configuration

# Only flag High severity & High confidence findings
severity: "high"
confidence: "high"

targets:
  - "."

# Directories to ignore during scanning
exclude_dirs:
  - "venv"
  - ".venv"
  - ".extras"
  - "tests"
  - "node_modules"

# Rule codes to skip globally
skips:
  # --- Developer Velocity Ignores ---
  - "B101" # assert_used: Ignore standard Python assertions
  - "B106" # hardcoded_password_funcarg
  - "B311" # random: Ignore standard random module (fine unless doing cryptography)
  - "B110" # try_except_pass: Ignore empty except blocks
  - "B112" # try_except_continue: Ignore except blocks with continue

  # --- Query & Process Ignores (Fixes the 30 noise items from your scan) ---
  - "B608" # hardcoded_sql_expressions: Ignore dynamic DuckDB query construction
  - "B606" # start_process_with_no_shell: Ignore os.execv usage in scripts

  # --- System & Subprocess Ignores ---
  - "B404" # import_subprocess: Allow importing standard subprocess module
  - "B603" # subprocess_without_shell_equals_true: Allow safe array-based execution
  - "B607" # start_process_with_partial_path: Allow commands without absolute paths
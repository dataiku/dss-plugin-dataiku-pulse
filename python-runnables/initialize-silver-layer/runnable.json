{
    "meta": {
        "label": "Initialize Silver Layer",
        "description": "Initialize Silver Layer from RAW. This is auto-performed during data collection but can be ran separate as needed to fix datasets.",
        "icon": "fas fa-filter",
        "category": "Dataiku PULSE Insights: Initialize"
    },
    "impersonate": false,
    "permissions": ["ADMIN"],
    "requiresGlobalAdmin": true,
    "resultType": "RESULT_TABLE",
    "resultLabel": "RESULTS",
    "extension": "txt",
    "mimeType": "text/plain",
    "macroRoles": [],
    "params": [
        {
            "type": "PRESET",
            "name": "pulse_primary",
            "label": "Choose PULSE Primary Configuration",
            "parameterSetId": "params-dashboard-instance",
            "mandatory": true
        },
        {
            "type": "BOOLEAN",
            "name": "force_update",
            "label": "Check to force rebuild of silver layer.",
            "defaultValue": true
        },
        {
            "name": "pulse_category",
            "type": "SELECT",
            "label": "Pulse Category",
            "selectChoices": [
                { "value": "all", "label": "All categories" },
                { "value": "agent_tools", "label": "Agent Tools" },
                { "value": "agents", "label": "Agents" },
                { "value": "dataiku_usage", "label": "Dataiku Usage" },
                { "value": "datasets", "label": "Datasets" },
                { "value": "footprint", "label": "Footprint" },
                { "value": "instance", "label": "Instance" },
                { "value": "knowledge_banks", "label": "Knowledge Banks" },
                { "value": "llms", "label": "LLMs" },
                { "value": "operating_system", "label": "Operating System" },
                { "value": "projects", "label": "Projects" },
                { "value": "recipes", "label": "Recipes" },
                { "value": "scenarios", "label": "Scenarios" },
                { "value": "users", "label": "Users" }
            ]
        }
        
    ]
}

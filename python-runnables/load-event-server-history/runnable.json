{
    "meta": {
        "label": "Load Event Server History",
        "description": "Import historical event-server files from a managed folder for one node or all discovered nodes.",
        "icon": "fas fa-history",
        "category": "Dataiku PULSE Insights: Data Gather"
    },
    "impersonate": false,
    "permissions": ["ADMIN"],
    "requiresGlobalAdmin": true,
    "resultType": "RESULT_TABLE",
    "resultLabel": "RESULTS",
    "extension": "txt",
    "mimeType": "text/plain",
    "macroRoles": [],
    "params": [
        {
            "type": "PRESET",
            "name": "pulse_primary",
            "label": "Choose PULSE Primary Configuration",
            "parameterSetId": "params-dashboard-instance",
            "mandatory": true
        },
        {
            "type": "STRING",
            "name": "folder_id",
            "label": "Managed Folder ID",
            "description": "Managed folder id containing exported event-server history files.",
            "mandatory": true
        },
        {
            "type": "SELECT",
            "name": "import_scope",
            "label": "Import Scope",
            "mandatory": true,
            "defaultValue": "all_nodes",
            "selectChoices": [
                {
                    "value": "all_nodes",
                    "label": "All discovered nodes"
                },
                {
                    "value": "single_node",
                    "label": "Single node"
                }
            ]
        },
        {
            "type": "STRING",
            "name": "node_id",
            "label": "Node ID",
            "description": "Required only when importing a single node.",
            "mandatory": false
        },
        {
            "type": "DATE",
            "name": "start_date",
            "label": "Start Date",
            "description": "Optional lower bound for history import.",
            "mandatory": false
        },
        {
            "type": "DATE",
            "name": "end_date",
            "label": "End Date",
            "description": "Optional upper bound for history import.",
            "mandatory": false
        }
    ]
}

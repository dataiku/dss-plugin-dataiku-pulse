{
    "meta" : {
        "label": "Macro Configuration",
        "description": "",
        "icon": "fa fa-calendar"
    },
    "defaultDefinableInline": false,
    "defaultDefinableAtProjectLevel": false,
    "pluginParams": [
        {
            "name": "macro_configs",
            "label": "Macro Configuration",
            "type": "OBJECT_LIST",
            "subParams": [
                {
                    "name": "sep3",
                    "label": "Select a Macro",
                    "type": "SEPARATOR"
                },
                {
                    "name": "macro_name",
                    "label": "Macro Name",
                    "type": "SELECT",
                    "selectChoices" : [
                        { "value": "data_gather_audit_logs", "label": "Data Gather Audit Logs"},
                        { "value": "data_gather_diskspace",  "label": "Data Gather Diskspace"},
                        { "value": "data_gather_filesystem", "label": "Data Gather Filesystem"},
                        { "value": "data_gather_instance",   "label": "Data Gather Instance Level"},
                        { "value": "data_gather_project",    "label": "Data Gather Project Level"}
                    ],
                    "mandatory": true
                },
                {
                    "name": "frequency",
                    "label": "Trigger Frequency",
                    "type": "SELECT",
                    "selectChoices" : [
                        { "value": "Daily",   "label": "Daily"},
                        { "value": "Hourly",  "label": "Hourly"}
                    ],
                    "mandatory": true
                },
                {
                    "name": "day_frequency",
                    "label": "Hour of Day",
                    "type": "INT",
                    "defaultValue": 17,
                    "visibilityCondition": "model.frequency == 'Daily'",
                    "mandatory": true
                }
                ,
                {
                    "name": "hour_frequency",
                    "label": "How many hours between",
                    "type": "INT",
                    "defaultValue": 4,
                    "visibilityCondition": "model.frequency == 'Hourly'",
                    "mandatory": true
                }
            ]
        }
    ],
    "params": []
}
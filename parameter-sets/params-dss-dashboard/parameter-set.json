/* This file is the descriptor for the parameter set params-dss-dashboard */
{
    "meta" : {
        // label: name of the parameter set as displayed, should be short
        "label": "Dataiku Pulse Dashboard",

        // description: longer string to help end users understand what these parameter correspond to
        "description": "",

        // icon: must be one of the FontAwesome 5.15.4 icons, complete list here at https://fontawesome.com/v5/docs/
        "icon": "fa fa-bar-chart"
    },

    /* if users are allowed to fill the values for an instance of this parameter
       set directly in the plugin component using it, as opposed to only be allowed
       to select already defined presets (default value, can be changed in plugin
       settings)
    */
    "defaultDefinableInline": false,

    /* if users are allowed to define presets at the project level in addition
       to the instance level (default value, can be changed in plugin settings) */
    "defaultDefinableAtProjectLevel": false,


    /* The field "params" holds a list of all the params
       for which the user will be prompted for values. The ones in
       pluginParams relate to plugin settings (ie instance-level)
       and the ones in params relate to element settings (ie recipe,
       dataset, ...)

       The values given by the user will override/complete the ones
       set by the user in the element's (dataset, recipe,...) config.

       To make parameters not visible in the element's config,
       define them here but not in the element's json.

       The available parameter types include:
       STRING, STRINGS, INT, DOUBLE, BOOLEAN, SELECT, MULTISELECT, MAP, TEXTAREA,
       PRESET, DATASET, DATASET_COLUMN, MANAGED_FOLDER, CREDENTIAL_REQUEST

       For the full list and for more details, see the documentation: https://doc.dataiku.com/dss/latest/plugins/reference/params.html
    */

    "pluginParams": [
{
            "name": "pulse_repo_url",
            "label": "Dataiku Pulse Github Repo",
            "type": "STRING",
            "description": "",
            "mandatory": true,
            "defaultValue": "https://github.com/dataiku/dss-plugin-dataiku-pulse.git"
        },
        {
            "name": "pulse_repo_branch",
            "label": "Dataiku Pulse Github Branch",
            "type": "STRING",
            "description": "",
            "mandatory": true,
            "defaultValue": "main"
        },
        {
            "name": "sep_pulse_dashboard",
            "description": "<hr color='#000000' size='3' noshade><h3>Dataiku Pulse Dashboard Information</h3>",
            "type": "SEPARATOR"
        },
        {
            "name": "pulse_project_key",
            "label": "Dataiku Pulse Dashboard Project Key",
            "type": "STRING",
            "description": "",
            "mandatory": true,
            "defaultValue": "DATAIKU_PULSE_DASHBOARD"
        },
        {
            "name": "pulse_project_url",
            "label": "Dataiku Pulse Dashboard Main Host URL",
            "type": "STRING",
            "description": "",
            "mandatory": true
        },
        {
            "name": "pulse_project_api",
            "label": "Dataiku Pulse Dashboard Main Host API",
            "type": "PASSWORD",
            "description": "API Key running as an ADMIN level user",
            "mandatory": true
        },
        {
            "name": "pulse_worker_key",
            "label": "Dataiku Pulse Worker Project Key",
            "type": "STRING",
            "description": "",
            "mandatory": true,
            "defaultValue": "DATAIKU_PULSE_WORKER"
        },
        {
            "name": "pulse_dataiku_user",
            "label": "Dataiku Pulse Worker Dataiku User",
            "type": "STRING",
            "description": "",
            "mandatory": true,
            "defaultValue": "admin"
        },
        {
            "type": "BOOLEAN",
            "name": "ignore_certs",
            "label": "Ignore Certificates and force trust TLS",
            "defaultValue": false
        },
        {
            "name": "pulse_folder_connection",
            "label": "Dataiku Pulse Folder Connection",
            "type": "STRING",
            "description": "",
            "mandatory": true
        },
        {
            "name": "do_parallel",
            "label": "Collect Project Data in Parallel",
            "type": "BOOLEAN",
            "description": "",
            "mandatory": true,
            "defaultValue": false
        },
        {
            "name": "cores",
            "label": "Number of cores for Parallel",
            "type": "INT",
            "description": "",
            "mandatory": true,
            "defaultValue": 2,
            "visibilityCondition": "model.do_parallel"
        }
    ],

    "params": [
        {
            "name": "parameter2",
            "type": "INT",
            "defaultValue" : 42
            /* Note that standard json parsing will return it as a double in Python (instead of an int), so you need to write
               int(self.config()['parameter2'])
            */
        },

        /* A "SELECT" parameter is a multi-choice selector. Choices are specified using the selectChoice field*/
        {
            "name": "parameter8",
            "type": "SELECT",
            "selectChoices": [
                {
                    "value": "val_x",
                    "label": "display name for val_x"
                },
                {
                    "value": "val_y",
                    "label": "display name for val_y"
                }
            ]
        }
    ]
}
